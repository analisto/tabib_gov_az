# Database - PostgreSQL Connection String
# Example: postgresql://username:password@host:port/database?sslmode=require&schema=your_schema
DATABASE_URL="postgresql://user:password@localhost:5432/mvp_marketplace?sslmode=require&schema=codeplace"

# NextAuth Configuration
# Production URL of your application
NEXTAUTH_URL="https://your-domain.com"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Cloudflare R2 Storage Configuration
# Find these in your Cloudflare dashboard under R2
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://your-bucket.r2.dev"
